apiVersion: batch/v1
kind: Job
metadata:
  name: {{.ObjectName}}
  labels:
    app: openbench
    run-id: {{.ObjectName | jsonQuote}}
spec:
  parallelism: {{.Nodes}}
  completions: {{.Nodes}}
  completionMode: Indexed
{{- if eq .OnFailure "collect-all" }}
  backoffLimitPerIndex: 0
{{- else }}
  backoffLimit: 0
{{- end }}
  template:
    metadata:
      labels:
        openbench-run: {{.ObjectName | jsonQuote}}
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  openbench-run: {{.ObjectName | jsonQuote}}
              topologyKey: kubernetes.io/hostname
      restartPolicy: Never
      activeDeadlineSeconds: {{.TimeoutSeconds}}
      containers:
        - name: test
          image: {{.Image}}
          command: ["/bin/sh", "-c", {{.Command | jsonQuote}}]
          env:
{{- range .Env }}
            - name: {{ .Name }}
              value: {{ .Value | jsonQuote }}
{{- end }}
            # Which cluster node this pod landed on — visible in collected logs
            # so users can confirm jobs spread across server + workers.
            - name: NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
